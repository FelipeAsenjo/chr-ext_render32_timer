{
  "name": "cross-browser-extension-starter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run build:chrome",
    "build:chrome": "vite build --mode chrome",
    "build:firefox": "vite build --mode firefox",
    "build:safari": "vite build --mode safari",
    "build:all": "npm run build:chrome && npm run build:firefox && npm run build:safari",
    "dev": "vite build --mode chrome --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run test && npm run build:all"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.2.0",
    "@types/node": "^26.6.3",
    "@types/webextension-polyfill": "^0.12.6",
    "eslint": "^9.37.0",
    "globals": "^16.4.0",
    "prettier": "^3.6.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^7.1.7",
    "vitest": "^5.0.2",
    "webextension-polyfill": "^0.12.0"
  }
}
